{% extends "base.html.j2" %}
{% block title %}{{ principle.title }}{% endblock %}
{% block content %}
<p><a href="{{ root }}index.html" class="back-link">&larr; Back to index</a></p>
<article>
  <hgroup>
    <h2>{{ principle.title }}</h2>
    <p>{{ principle.summary }}</p>
  </hgroup>
  {% if principle.toc_html %}
  <nav class="toc" aria-label="Table of contents">
    <strong>Contents</strong>
    {{ principle.toc_html | safe }}
  </nav>
  {% endif %}
  {{ principle.content_html | safe }}
</article>
{% endblock %}
