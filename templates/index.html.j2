{% extends "base.html.j2" %}
{% block title %}how{% endblock %}
{% block content %}
<section>
  <h2>Principles</h2>
  <div class="card-grid">
    {% for principle in principles %}
    <a class="card" href="{{ root }}principles/{{ principle.slug }}.html">
      <h3>{{ principle.title }}</h3>
      <p>{{ principle.summary }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<section>
  <h2>Patterns</h2>
  <div class="card-grid">
    {% for pattern in patterns %}
    <a class="card" href="{{ root }}patterns/{{ pattern.slug }}.html">
      <h3>{{ pattern.title }}</h3>
      <p>{{ pattern.summary }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endblock %}
